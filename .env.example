# ============================================================================
# ENVIRONMENT CONFIGURATION - Student Research Assistant
# ============================================================================
# Copy this file to .env and customize for your environment
# Do NOT commit .env to version control
# ============================================================================

# ============================================================================
# LLM CONFIGURATION (Ollama)
# ============================================================================
# Ollama server URL (default: local)
RESEARCH_OLLAMA_BASE_URL=http://localhost:11434

# Default LLM model for agent reasoning
# Options: llama3.2, mistral, codellama, etc.
RESEARCH_OLLAMA_MODEL=llama3.2

# LLM temperature (0.0 = deterministic, 1.0 = creative)
RESEARCH_LLM_TEMPERATURE=0.7

# Maximum tokens for LLM response
RESEARCH_LLM_MAX_TOKENS=2048

# ============================================================================
# EMBEDDING CONFIGURATION
# ============================================================================
# Embedding model name
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, nomic-embed-text
RESEARCH_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Device for embeddings (cpu, cuda, mps)
RESEARCH_EMBEDDING_DEVICE=cpu

# ============================================================================
# VECTOR DATABASE (ChromaDB)
# ============================================================================
# ChromaDB persistence directory
RESEARCH_CHROMA_PERSIST_DIR=./data/vectorstore

# Default collection name
RESEARCH_CHROMA_COLLECTION=research_documents

# ChromaDB server mode (for production)
# RESEARCH_CHROMA_HOST=localhost
# RESEARCH_CHROMA_PORT=8000

# ============================================================================
# DOCUMENT PROCESSING
# ============================================================================
# Document chunk size in characters
RESEARCH_CHUNK_SIZE=1000

# Chunk overlap in characters
RESEARCH_CHUNK_OVERLAP=200

# Upload directory
RESEARCH_UPLOAD_DIR=./data/documents

# Maximum file size in MB
RESEARCH_MAX_FILE_SIZE_MB=50

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
# Maximum iterations for agent workflow
RESEARCH_MAX_ITERATIONS=5

# Maximum revisions by critic
RESEARCH_MAX_REVISIONS=3

# Number of documents to retrieve
RESEARCH_RETRIEVAL_TOP_K=5

# Minimum similarity score (0.0 - 1.0)
RESEARCH_RETRIEVAL_THRESHOLD=0.5

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
RESEARCH_LOG_LEVEL=INFO

# Enable JSON logging (for production)
RESEARCH_LOG_JSON=false

# Application environment (development, staging, production)
RESEARCH_ENVIRONMENT=development

# Enable debug mode
RESEARCH_DEBUG=true

# ============================================================================
# STREAMLIT UI
# ============================================================================
# Streamlit server port
STREAMLIT_SERVER_PORT=8501

# Streamlit server address
STREAMLIT_SERVER_ADDRESS=localhost

# Enable wide mode
STREAMLIT_WIDE_MODE=true

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================
# LangSmith tracing (optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-api-key
# LANGCHAIN_PROJECT=research-assistant

# Prometheus metrics port (optional)
# METRICS_PORT=9090
